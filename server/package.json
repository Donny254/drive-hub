{
  "name": "drive-hub-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bash -lc 'for file in src/*.js src/routes/*.js src/middleware/*.js src/utils/*.js scripts/*.js tests/*.mjs; do [ -f \"$file\" ] && node --check \"$file\"; done'",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:content": "node scripts/seed-content.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.12.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "ip-address": "^10.7.3",
    "proxy-addr": "^2.0.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
