# Drive Hub API - production environment template
# Copy to: server/.env on the deployment host, or put these values in your
# platform secret manager. Do not commit real values.

# Core app
NODE_ENV=production
PORT=8080

# Database
# Pick ONE DATABASE_URL format below and set it.
# Keep sslmode=require for managed providers.

# Render / Railway / Neon / most managed Postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Supabase (pooler)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# AWS RDS (Postgres)
# DATABASE_URL=postgresql://USER:PASSWORD@rds-endpoint.REGION.rds.amazonaws.com:5432/DB_NAME?sslmode=require

# Active value
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# For this app, set true when your DB requires TLS.
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
# Optional when your provider requires a custom CA certificate bundle.
# PGSSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# PGSSL_CA_FILE=/etc/ssl/certs/your-db-ca.pem

# Security
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origins allowed to call API (comma-separated)
# List every production frontend origin that calls the API.
CORS_ORIGIN=https://wheelsnation.co.ke
FRONTEND_URL=https://wheelsnation.co.ke
# Optional: set this only when the refresh cookie must be shared across subdomains.
# REFRESH_COOKIE_DOMAIN=.wheelsnation.co.ke

# M-Pesa
# Encrypts Daraja credentials stored via the admin UI (required for that feature).
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
MPESA_ENV=production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/payments/stk/result
# https origin used to build C2B/pull webhook URLs (validation, confirmation, pull result).
# Falls back to the base derived from MPESA_CALLBACK_URL ending in /stk/result.
MPESA_CALLBACK_BASE_URL=
MPESA_PARTYB=your_partyb_or_shortcode
MPESA_ACCOUNT_REFERENCE=DriveHub Order
# Comma-separated Safaricom callback source IPs; empty = allow all (sandbox).
# Production: set to Safaricom's published callback IP ranges.
MPESA_CALLBACK_IP_ALLOWLIST=
MPESA_TRANSACTION_DESC=DriveHub checkout
# Callback recovery attempts before an inbox item moves to manual review.
MPESA_CALLBACK_MAX_ATTEMPTS=12
MPESA_CALLBACK_BATCH_SIZE=20
MPESA_RECOVERY_POLL_MS=15000
MPESA_CALLBACK_ABANDONED_MINUTES=15
# Per-channel ticket notification outbox worker.
MPESA_NOTIFICATION_BATCH_SIZE=10
MPESA_NOTIFICATION_POLL_MS=15000
MPESA_NOTIFICATION_LEASE_MINUTES=15

# Bank transfer details (shown for high-value orders)
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Your Company Limited
BANK_ACCOUNT_NUMBER=1234567890
BANK_BRANCH=Main Branch
BANK_SWIFT=ABCDEF12
BANK_INSTRUCTIONS=Use order or listing reference and share transfer receipt.

# Email notifications (inquiries)
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@yourdomain.com
INQUIRY_NOTIFY_EMAIL=alerts@yourdomain.com
ADMIN_DIGEST_EMAIL=ops@yourdomain.com

# Daily email digests (UTC hour, 0-23)
DIGESTS_ENABLED=true
DIGESTS_HOUR_UTC=6

# SMS / WhatsApp notifications
# Point this to your own messaging bridge or provider webhook.
MESSAGING_PROVIDER=generic_webhook
MESSAGING_WEBHOOK_URL=https://messaging.yourdomain.com/send
MESSAGING_WEBHOOK_TOKEN=replace-with-api-token
SMS_FROM=WheelsnationKe
WHATSAPP_FROM=254700000000
